{
  "name": "px-nbfun",
  "main": "worker.js",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "px.nbfun.com", "custom_domain": true }
  ],
  "r2_buckets": [
    { "binding": "PASTE", "bucket_name": "pxnbfun" }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
